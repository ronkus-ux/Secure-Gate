# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must NEVER be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Cloud PostgreSQL (Neon, Supabase, Vercel Postgres, or local Postgres).
# Use a DIRECT connection, not a pooler (no "-pooler" in the hostname),
# otherwise `prisma migrate dev` fails to apply migrations.
DATABASE_URL=

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If this ever leaks, an attacker can forge a session cookie for ANY user.
# Rotate it immediately. See REFLECTION.md Q12.
NEXTAUTH_SECRET=

# http://localhost:3000 locally. Your Vercel domain in production.
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Create a key at https://resend.com/api-keys
# NOTE: the default sender onboarding@resend.dev can ONLY email the address
# that owns the Resend account. Sending to anyone else returns HTTP 403.
# To send to real users, verify a domain you own at resend.com/domains.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis)
# ---------------------------------------------------------------------------
# Create a database at https://console.upstash.com
# Only REQUIRED once deployed to Vercel. Locally the in-memory fallback works
# because your laptop runs a single copy of the app. On Vercel each request may
# land on a different instance, so an in-memory counter is per-instance and
# resets on cold start. See REFLECTION.md Q9.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
