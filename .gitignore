# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.pdf

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files - NEVER commit real secrets.
# .env.example is the committed template with empty placeholders, so it is
# explicitly re-included below. Everything else (.env, .env.local,
# .env.production, ...) stays ignored.
.env*
!.env.example

# vercel
.vercel

# AI assistant instruction files - these are tooling config for my own
# development process, not part of the application, so they are not part of
# the submitted work. Kept on disk, excluded from the repository.
AGENTS.md
CLAUDE.md

# typescript
*.tsbuildinfo
next-env.d.ts
