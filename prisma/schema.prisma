// SecureGate — Prisma schema
//
// This file is the SOURCE OF TRUTH for the shape of the database.
// `prisma migrate dev` turns it into real SQL tables in Postgres.
//
// Important mental model: this file is NOT the database.
// It is a description of it. The real table has columns, constraints,
// foreign keys, and indexes that Prisma hides from you. See REFLECTION.md Q8.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Read from .env.local, never hardcoded. A real credential committed to
  // git is a permanent breach — see REFLECTION.md Q12.
  url = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User — one row per registered person
// ---------------------------------------------------------------------------
model User {
  // cuid: a collision-resistant, sortable id. The default is generated by
  // Postgres, not by your code, so it is invisible in this model.
  id String @id @default(cuid())

  // Nullable: signing up without a display name is allowed.
  name String?

  // @unique creates a real UNIQUE constraint in Postgres. It also means this
  // column is a legal target for a foreign key, which is why the token
  // tables below can point at it.
  email String @unique

  // A bcrypt hash, ALWAYS. Never a plain password.
  // Hashes look like: $2b$12$<22 char salt><31 char hash>
  password String

  // DateTime? and not Boolean, on purpose:
  //   null            -> not verified
  //   2026-09-29T... -> verified, AND we know exactly when
  // A Boolean would answer "is it verified?" but throw away "when?",
  // which is data you can never get back.
  emailVerified DateTime?

  // @default(now()) and @updatedAt are handled by Prisma/the client at
  // write time. They are not database triggers. Another leaky abstraction.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

// ---------------------------------------------------------------------------
// VerificationToken — proves the user owns their email address
// ---------------------------------------------------------------------------
model VerificationToken {
  id String @id @default(cuid())

  // The user's email, not their id. We deliberately store the human-readable
  // key so the token row is meaningful when you inspect the table by hand.
  identifier String

  // We store sha256(token), NOT the raw token.
  //
  // The raw token only ever exists inside the email inbox and the URL. If
  // someone obtains a database dump (SQL injection, a leaked backup, a
  // careless engineer), hashed tokens are useless to them: they cannot log in
  // as an unverified user or reset anyone's password.
  //
  // This is Kerckhoffs's Principle applied to storage: our security must not
  // depend on the database remaining secret. See REFLECTION.md Q4.
  tokenHash String @unique

  // Created at generation time as now() + 15 minutes. A token is a
  // single-use, time-limited key: 15 minutes is the window an attacker has
  // if the email is intercepted.
  expires DateTime

  createdAt DateTime @default(now())

  // A REAL foreign key. onDelete: Cascade means deleting a User also deletes
  // their tokens, so we never accumulate orphan rows.
  user User @relation(fields: [identifier], references: [email], onDelete: Cascade)

  // Not the same job as @unique above. The index speeds up "find all tokens
  // for this email" lookups; uniqueness prevents two tokens from colliding.
  @@index([identifier])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// PasswordResetToken — lets a user set a new password they have forgotten
// ---------------------------------------------------------------------------
model PasswordResetToken {
  id String @id @default(cuid())

  email String

  // Hashed for the same reason as VerificationToken.tokenHash.
  tokenHash String @unique

  // 1 hour rather than 15 minutes: the user has to find the email, open it,
  // click the link, and invent a password they will actually remember.
  expires DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
  @@map("password_reset_tokens")
}
